rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthorized() {
      return request.auth != null && 
        request.auth.token.email != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthorized() && getUser().role == "admin";
    }
    
    function isHOD() {
      return isAuthorized() && getUser().role == "hod";
    }
    
    function isFaculty() {
      return isAuthorized() && getUser().role == "faculty";
    }

    // User profile document rules
    match /users/{userId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && request.auth.uid == userId &&
        (request.resource.data.role != 'student' || request.auth.token.email.matches('.*@sriniet[.]edu[.]in$'));
      allow update: if isAuthorized() && (request.auth.uid == userId || isAdmin() || isHOD());
      allow delete: if isAdmin();
    }
    
    // Leave requests rules
    match /leaveRequests/{leaveId} {
      allow read: if isAuthorized() && (
        resource.data.studentUid == request.auth.uid ||
        isFaculty() ||
        isHOD() ||
        isAdmin()
      );
      
      allow create: if isAuthorized() && request.resource.data.studentUid == request.auth.uid;
      
      allow update: if isAuthorized() && (
        (resource.data.studentUid == request.auth.uid && request.resource.data.status == "cancelled") ||
        (isFaculty() && resource.data.status == "pending_faculty") ||
        (isHOD() && (resource.data.status == "pending_hod" || resource.data.department == getUser().department)) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
    
    // Department Working Days configuration
    match /departmentWorkingDays/{docId} {
      allow read: if isAuthorized();
      allow write: if isHOD() || isAdmin();
    }

    // Faculty Leave Requests
    match /facultyLeaveRequests/{leaveId} {
      allow read: if isAuthorized() && (
        resource.data.facultyUid == request.auth.uid ||
        isHOD() ||
        isAdmin()
      );
      
      allow create: if isAuthorized() && 
        (isFaculty() || isHOD()) &&
        request.resource.data.facultyUid == request.auth.uid;
      
      allow update: if isAuthorized() && (
        (resource.data.facultyUid == request.auth.uid && request.resource.data.status == "cancelled") ||
        (isHOD() && resource.data.department == getUser().department) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // In-app & FCM push notifications
    match /notifications/{notifId} {
      allow read: if isAuthorized() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthorized();
      allow update: if isAuthorized() && resource.data.recipientUid == request.auth.uid;
      allow delete: if isAuthorized() && (resource.data.recipientUid == request.auth.uid || isAdmin());
    }

    // Staff Lookup index for Employee ID -> email resolution during login
    match /staffLookups/{employeeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isAuthorized() && (isAdmin() || request.auth.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    // Atomic Staff ID Counters
    match /staffCounters/{counterId} {
      allow read, write: if true;
    }

    // SMS Notification Audit Logs
    match /sms_logs/{logId} {
      allow read: if isAuthorized() && (
        resource.data.recipientUid == request.auth.uid ||
        isFaculty() ||
        isHOD() ||
        isAdmin()
      );
      allow create: if isAuthorized();
      allow update, delete: if isAdmin();
    }
  }
}
